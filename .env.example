# Copy this file to .env and fill in real values. Never commit the real .env.

# https://openweathermap.org/api — free tier covers current + historical air pollution
OPENWEATHER_API_KEY=

# Supabase (Postgres) — Settings -> Database -> Connection string -> URI (use the "Transaction pooler" one)
SUPABASE_DB_URL=

# Hugging Face Hub (model registry) — huggingface.co/settings/tokens, needs "write" access
HF_TOKEN=
HF_MODEL_REPO=your-username/aqi-forecast-model
AQICN_API_KEY=